# local-photo-ai-m5 — environment template
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Optional. Only needed to download models/LoRAs from Civitai.
# Create at https://civitai.com/user/account -> API Keys
CIVITAI_TOKEN=

# Optional. Override where model weights live.
# Default: the Draw Things app container Models directory (detected at runtime).
# LOCAL_PHOTO_MODELS_DIR=

# Optional. Override the default output directory for generations that do not
# pass --output. Default: <cwd>/.local-photo
# LOCAL_PHOTO_OUTPUT_DIR=

# Optional. Path to the draw-things-cli binary if it is not on PATH.
# LOCAL_PHOTO_DT_CLI=

# Optional. Warm-server (gRPC) address used by `local-photo serve`.
# Always loopback — never bind to 0.0.0.0.
# LOCAL_PHOTO_GRPC_HOST=127.0.0.1
# LOCAL_PHOTO_GRPC_PORT=7859
